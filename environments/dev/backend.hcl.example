# Copy this file to backend.hcl (git-ignored) and fill in real values, then:
#
#   terraform init -backend-config=backend.hcl
#
# The bucket must already exist, have versioning enabled, default encryption
# with a KMS key, and Block Public Access turned on.

bucket       = "platform-terraform-state-790354569983-ap-northeast-1"
key          = "network/dev/terraform.tfstate"
region       = "ap-northeast-1"
encrypt      = true

# Only needed when the bucket uses SSE-KMS; leave it out for SSE-S3.
# kms_key_id = "arn:aws:kms:ap-northeast-1:790354569983:key/REPLACE-ME"

# S3-native state locking (Terraform >= 1.10). Drop this and set
# `dynamodb_table` instead if your organisation still pins older versions.
use_lockfile = true

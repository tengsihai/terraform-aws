# Copy to terraform.tfvars (git-ignored) and fill in real values.

github_owner = "tengsihai"
github_repo  = "terraform-aws"

# Other repositories allowed to assume the plan/apply roles. The react-aws
# pipeline deploys the static frontend into the site bucket this stack creates;
# lambda-aws deploys the function that runs behind it.
additional_github_repos = [
  "tengsihai/react-aws",
  "tengsihai/lambda-aws",
]

# Buckets the pipeline may list (aws s3api head-bucket / aws s3 sync).
# Object-level Get/Put/Delete are already granted by ManageLogBuckets.
pipeline_bucket_arns = [
  "arn:aws:s3:::platform-dev-site-790354569983-ap-northeast-1",
]

state_bucket_name = "platform-terraform-state-790354569983-ap-northeast-1"
# state_kms_key_arn = "arn:aws:kms:ap-northeast-1:790354569983:key/REPLACE-ME"

# Only dev is provisioned for now. Adding staging/prod later means editing this
# list and re-applying, so their roles and trust policies get created.
environments = ["dev"]

# Uncomment when the account already has the GitHub OIDC provider.
# create_oidc_provider = false
# oidc_provider_arn    = "arn:aws:iam::790354569983:oidc-provider/token.actions.githubusercontent.com"
